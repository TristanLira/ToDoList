<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.todolist.AuthenticationController"
      stylesheets="@css/authentication.css"
      alignment="CENTER"
      spacing="30">

    <Label fx:id = "titleLabel" text = "To Do List" alignment="CENTER" />

    <VBox spacing = "40" alignment="CENTER" fillWidth="false">

        <Label text = "Inicia sesión o registrate." alignment = "CENTER"/>

        <GridPane fx:id ="userDataGrid" alignment="CENTER" hgap = "10" vgap="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label alignment="CENTER_RIGHT" text = "Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label alignment="CENTER_RIGHT" text = "Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id = "userField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <PasswordField fx:id = "passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing = "20" alignment = "CENTER">
            <Button fx:id = "loginButton" onAction="#login" text = "Iniciar sesión"/>
            <Button fx:id = "registerButton" onAction="#createUser" text = "Registro"/>
            <Button fx:id = "debugButton" onAction="#quickLogin" text = "DEBUG"/>
        </HBox>
    </VBox>

</VBox>